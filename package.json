{
  "author": "",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0",
    "dataloader": "^2.2.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.0",
    "graphql": "^16.8.1",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "^4.1.0",
    "lodash": "^4.18.1",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "description": "",
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/introspection": "6.1.0",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-resolvers": "6.1.1",
    "@parcel/watcher": "^2.6.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^10.0.0",
    "eslint": "^8.54.0",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^6.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.14"
  },
  "keywords": [],
  "license": "ISC",
  "main": "index.ts",
  "name": "expenses-graphql",
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --watch --config codegen.ts",
    "copy-assets": "cp -r ./migrations ./seeders ./config ./dist/",
    "compile": "tsc",
    "delete:dist": "rm -rf ./dist",
    "build": "pnpm delete:dist && pnpm codegen && pnpm compile && pnpm copy-assets",
    "deploy:prod": "pnpm build && fly deploy",
    "dev": "NODE_ENV=dev nodemon",
    "lint": "eslint . --ext .ts",
    "migrate": "npx sequelize-cli db:migrate",
    "db:migrate": "npx sequelize-cli db:migrate",
    "seeds": "npx sequelize-cli db:seed:all",
    "mcp": "node --loader ts-node/esm src/mcp/index.ts",
    "rates:backfill": "node --loader ts-node/esm src/scripts/backfill-exchange-rates.ts",
    "test": "vitest",
    "watch": "concurrently  --names \"CodeGen,TS,Nodemon\" -c \"bgYellow,bgBlue,bgMagenta\" \"pnpm codegen:watch\"  \"tsc -w \" \"pnpm dev \""
  },
  "graphql": {
    "schema": "http://localhost:4000/graphql",
    "documents": "**/*.{graphql,js,ts}"
  },
  "type": "module",
  "version": "1.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3"
    ]
  }
}
